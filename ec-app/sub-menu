        const channelGrid = document.getElementById("channel-grid");
        function renderChannels(canales) {
            channelGrid.innerHTML = '';
            canales.forEach((canal) => {
                const card = document.createElement("div");
                card.className = "channel-card";
                card.innerHTML = `
                    <img src="${canal.imagen}" alt="${canal.nombre}">
                    <div class="text-container">
                        <h2>${canal.nombre}</h2>
                    </div>
                `;
                card.onclick = () => {
                    PlayerApp.onPlay(canal.url, "", canal.params);
                };
                channelGrid.appendChild(card);
            });
        }
        document.getElementById("search-bar").addEventListener("input", function () {
            const searchTerm = this.value.toLowerCase();
            const filteredCanales = canalesData.filter(canal => canal.nombre.toLowerCase().includes(searchTerm));
            renderChannels(filteredCanales);
        });
        renderChannels(canalesData);
